.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.env
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
outputs/*
!outputs/.gitkeep
library/thumbnails/*
!library/thumbnails/.gitkeep
outputs/.review_frames/

# --- Illustration Studio: private data root ---
# Binary originals, family/inspiration references, proprietary product masters
# and generated illustration bytes. Never commit these to a public repo.
.betty_data/
# Brand-asset uploads land under brands/<id>/studio/assets/ at runtime.
# Keep already-tracked seed art, but never auto-commit new private uploads.
brands/*/studio/assets/*
!brands/*/studio/assets/.gitkeep
